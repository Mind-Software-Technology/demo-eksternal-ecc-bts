# Salin ke .env.local (gitignored) dan isi nilainya.

NEXT_PUBLIC_API_URL=https://api.ecc-bts.id

# Domain kanonik situs — dipakai sitemap.xml, robots.txt, dan tag canonical.
# Harus persis sama dengan domain yang didaftarkan di Google Search Console,
# termasuk ada/tidaknya "www". Salah satu saja beda, Google menganggapnya dua
# situs terpisah dan peringkatnya terbagi dua.
NEXT_PUBLIC_SITE_URL=https://www.ecc-bts.id

# Kode verifikasi Google Search Console (metode "tag HTML"). Isi hanya bagian
# content="..."-nya saja, bukan seluruh tag. Boleh dikosongkan kalau memakai
# verifikasi lewat DNS TXT di registrar domain.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

GOOGLE_CLIENT_ID=

# Kunci publik VAPID untuk web push — nilainya sama persis dengan
# VAPID_PUBLIC_KEY di .env backend. Memang publik (ikut masuk ke bundle
# browser); yang rahasia adalah VAPID_PRIVATE_KEY dan itu hanya di backend.
# Tanpa ini, notifikasi push tidak akan pernah terdaftar — lonceng dan polling
# tetap jalan, tapi notifikasi saat situs ditutup tidak akan sampai.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
